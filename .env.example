# Optional install settings for bin/junie and bin/claude.
#
# Copy this file to .env and uncomment the settings you want to change.
# .env is gitignored. Variables already set in your environment take precedence.
# Any setting left commented out falls back to its `*_DEFAULT_*` setting and
# then to the script's built-in default. Setting one to an empty value (e.g.
# JUNIE_PLANNING_MODEL=) omits that field from the front matter.
#
# After changing this file, re-run `bin/junie install` and/or `bin/claude install`.

# --- Junie ------------------------------------------------------------------
# Defaults: planning "sonnet" / high, implementation and verification "sonnet" / low.
#
# Custom model profiles in ~/.junie/models/<profile>.json are selected with the
# "custom:<profile>" format, where <profile> is the file name without ".json".
# Example: LiteLLM gateway profiles litellm-sonnet.json and litellm-haiku.json.

# JUNIE_DEFAULT_MODEL=custom:litellm-sonnet
# JUNIE_DEFAULT_REASONING=low

# JUNIE_PLANNING_MODEL=custom:litellm-sonnet
# JUNIE_PLANNING_REASONING=high

# JUNIE_IMPLEMENTATION_MODEL=custom:litellm-sonnet
# JUNIE_IMPLEMENTATION_REASONING=low

# JUNIE_VERIFICATION_MODEL=custom:litellm-sonnet
# JUNIE_VERIFICATION_REASONING=low

# --- Claude Code ------------------------------------------------------------
# Defaults: planning claude-sonnet-5-5 / high, implementation and verification
# claude-sonnet-5-5 / low. Use the model names your gateway exposes if Claude
# Code is pointed at one (ANTHROPIC_BASE_URL).

# CLAUDE_DEFAULT_MODEL=claude-sonnet-5-5
# CLAUDE_DEFAULT_EFFORT=low

# CLAUDE_PLANNING_MODEL=claude-sonnet-5-5
# CLAUDE_PLANNING_EFFORT=high

# CLAUDE_IMPLEMENTATION_MODEL=claude-sonnet-5-5
# CLAUDE_IMPLEMENTATION_EFFORT=low

# CLAUDE_VERIFICATION_MODEL=claude-sonnet-5-5
# CLAUDE_VERIFICATION_EFFORT=low
