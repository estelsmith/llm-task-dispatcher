#!/usr/bin/env bash
#
# Installs, uninstalls and verifies the task dispatcher command and agents
# in the user's Claude Code configuration directory.
#
#   bin/claude install     Install commands/ as skills and agents/ as subagents into ~/.claude
#   bin/claude uninstall   Remove the files installed by this repository
#   bin/claude doctor      Verify installed files are present and match the repository
#
# The repository files are vendor-neutral templates containing {{placeholder}}
# variables. They are rendered with the Claude Code-specific values defined in
# PLACEHOLDERS below as they are copied into the Claude Code configuration directory.
#
# Commands are installed as skills (skills/<name>/SKILL.md), which is where the
# Claude Desktop app and current Claude Code versions discover slash commands.
# Agents are installed as-is into agents/.
#
# The configuration directory defaults to ~/.claude and can be overridden with
# CLAUDE_CONFIG_DIR, the same variable Claude Code itself uses.
#
# Each agent's model and effort level can be overridden with CLAUDE_*_MODEL and
# CLAUDE_*_EFFORT, either in the environment or in the repository's .env file
# (see .env.example). Setting one to an empty value omits it from the front matter.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    link_dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$link_dir/$SCRIPT_PATH"
done
source "$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)/lib/installer.sh"

TOOL_NAME="Claude Code"
HOME_ENV_VAR="CLAUDE_CONFIG_DIR"
DEFAULT_HOME="$HOME/.claude"

# Prints an agent's model front matter. Arguments: the agent's variable prefix
# (e.g. PLANNING), its default model and its default effort level.
claude_agent_frontmatter() {
    local model_var="CLAUDE_$1_MODEL" effort_var="CLAUDE_$1_EFFORT" model effort
    model="${!model_var-$2}"
    effort="${!effort_var-$3}"
    join_lines "${model:+model: $model}" "${effort:+effort: $effort}"
}

# Installs commands/<name>.md as skills/<name>/SKILL.md; everything else keeps its path.
install_path() {
    local rel="$1" name
    if [[ "$rel" == commands/*.md ]]; then
        name="$(basename "$rel" .md)"
        printf 'skills/%s/SKILL.md\n' "$name"
    else
        printf '%s\n' "$rel"
    fi
}

# Claude Code-specific placeholder values, as alternating name/value pairs.
# A value may span multiple lines and may be empty.
PLACEHOLDERS=(
    # Command (skill) front matter and the variable holding the command's argument.
    # disable-model-invocation keeps Claude from starting the pipeline on its own.
    command-frontmatter 'name: task-dispatcher
argument-hint: "[task-file]"
disable-model-invocation: true'
    task-argument       '$ARGUMENTS'

    # Directory (relative to the project root) holding the task pipeline folders.
    tasks-dir           '.claude/tasks'

    # Tool used by the orchestrator to delegate work to a sub-agent.
    spawn-agent         'the `Agent` tool'

    # Agent front matter: tool allow-list, and model settings per agent.
    agent-tools 'tools: Read, Write, Edit, Bash'
    planning-frontmatter       "$(claude_agent_frontmatter PLANNING claude-sonnet-5-5 medium)"
    implementation-frontmatter "$(claude_agent_frontmatter IMPLEMENTATION claude-haiku-5-5 high)"
    verification-frontmatter   "$(claude_agent_frontmatter VERIFICATION claude-haiku-5-5 high)"

    # Tool agents use to run shell commands.
    shell-tool 'the `Bash` tool'

    # Tools the dispatcher uses to create and edit task files.
    file-edit-tools 'the `Write` and `Edit` tools'
)

main "$@"
