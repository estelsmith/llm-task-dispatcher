#!/usr/bin/env bash
#
# Installs, uninstalls, and checks the task dispatcher templates in ~/.claude
# (or $CLAUDE_CONFIG_DIR).
#
#   bin/claude install           Render and copy commands + agents
#   bin/claude uninstall         Remove only the files this repo installed
#   bin/claude doctor [--diff]   Check installed files against the rendered templates
#
# Templates use {{placeholder}} tags so commands/ and agents/ stay tool-neutral.
# Claude Desktop and current Claude Code discover slash commands as skills, so
# commands/*.md get written to skills/<name>/SKILL.md while agents stay in agents/.
#
# Override per-agent models and effort with CLAUDE_*_MODEL / CLAUDE_*_EFFORT
# (or CLAUDE_DEFAULT_MODEL / CLAUDE_DEFAULT_EFFORT) in .env or your shell.
# Setting one to empty drops that field from front matter completely.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    link_dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$link_dir/$SCRIPT_PATH"
done
source "$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)/lib/installer.sh"

TOOL_NAME="Claude Code"
HOME_ENV_VAR="CLAUDE_CONFIG_DIR"
DEFAULT_HOME="$HOME/.claude"

# Builds an agent's front matter from $1 (like PLANNING), falling back through
# CLAUDE_DEFAULT_* to the script's built-in defaults ($2, $3).
claude_agent_frontmatter() {
    local model_var="CLAUDE_$1_MODEL" effort_var="CLAUDE_$1_EFFORT" default_model default_effort model effort
    default_model="${CLAUDE_DEFAULT_MODEL-$2}"
    default_effort="${CLAUDE_DEFAULT_EFFORT-$3}"
    model="${!model_var-$default_model}"
    effort="${!effort_var-$default_effort}"
    join_lines "${model:+model: $model}" "${effort:+effort: $effort}"
}

# Rewrite commands/<name>.md to skills/<name>/SKILL.md since that's where Claude Code looks for slash commands.
install_path() {
    local rel="$1" name
    if [[ "$rel" == commands/*.md ]]; then
        name="$(basename "$rel" .md)"
        printf 'skills/%s/SKILL.md\n' "$name"
    else
        printf '%s\n' "$rel"
    fi
}

read_tasks_dir _task_dispatcher_tasks_dir '.claude/tasks'

# Alternating placeholder name/value pairs (empty values are fine).
PLACEHOLDERS=(
    # Command (skill) front matter and the variable holding the command's argument.
    # disable-model-invocation keeps Claude from starting the pipeline on its own.
    command-frontmatter 'name: task-dispatcher
argument-hint: "[task-file] [instructions]"
disable-model-invocation: true'
    task-argument       '$ARGUMENTS'

    # Project-relative folder for the task pipeline directories.
    tasks-dir           "$_task_dispatcher_tasks_dir"

    # Tool the dispatcher uses to spawn a sub-agent.
    spawn-agent         'the `Agent` tool'

    # Agent front matter: tool allow-list, and model settings per agent.
    agent-tools 'tools: Read, Write, Edit, Bash'
    planning-frontmatter       "$(claude_agent_frontmatter PLANNING claude-sonnet-5-5 high)"
    implementation-frontmatter "$(claude_agent_frontmatter IMPLEMENTATION claude-sonnet-5-5 low)"
    verification-frontmatter   "$(claude_agent_frontmatter VERIFICATION claude-sonnet-5-5 low)"

    # Tool agents use to run shell commands.
    shell-tool 'the `Bash` tool'

    # Tools the dispatcher uses to create and edit task files.
    file-edit-tools 'the `Write` and `Edit` tools'
)

main "$@"
