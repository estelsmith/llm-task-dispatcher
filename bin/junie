#!/usr/bin/env bash
#
# Installs, uninstalls and verifies the task dispatcher command and agents
# in the user's Junie home directory.
#
#   bin/junie install     Copy commands/ and agents/ into ~/.junie (install or update)
#   bin/junie uninstall   Remove the files installed by this repository
#   bin/junie doctor      Verify installed files are present and match the repository
#
# The repository files are vendor-neutral templates containing {{placeholder}}
# variables. They are rendered with the Junie-specific values defined in
# PLACEHOLDERS below as they are copied into the Junie home directory.
#
# The Junie home directory defaults to ~/.junie and can be overridden with JUNIE_HOME.
#
# Each agent's model and reasoning level can be overridden with JUNIE_*_MODEL and
# JUNIE_*_REASONING, either in the environment or in the repository's .env file
# (see .env.example). Setting one to an empty value omits it from the front matter.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    link_dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$link_dir/$SCRIPT_PATH"
done
source "$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)/lib/installer.sh"

TOOL_NAME="Junie"
HOME_ENV_VAR="JUNIE_HOME"
DEFAULT_HOME="$HOME/.junie"

# Prints an agent's model front matter. Arguments: the agent's variable prefix
# (e.g. PLANNING), its default model and its default reasoning level.
junie_agent_frontmatter() {
    local model_var="JUNIE_$1_MODEL" reasoning_var="JUNIE_$1_REASONING" model reasoning
    model="${!model_var-$2}"
    reasoning="${!reasoning_var-$3}"
    join_lines \
        "${model:+model: \"$model\"}" \
        "${reasoning:+reasoningLevel: \"$reasoning\"}" \
        'allowPromptArgument: true'
}

# Junie-specific placeholder values, as alternating name/value pairs.
# A value may span multiple lines and may be empty.
PLACEHOLDERS=(
    # Command front matter and the variable holding the command's argument.
    command-frontmatter 'allowPromptArgument: true'
    task-argument       '$task'

    # Directory (relative to the project root) holding the task pipeline folders.
    tasks-dir           '.junie/tasks'

    # Tool used by the orchestrator to delegate work to a sub-agent.
    spawn-agent         '`spawn_subagent`'

    # Agent front matter: tool allow-list, and model settings per agent.
    agent-tools 'tools: ["Read", "Glob", "Grep", "Write", "Edit", "Bash"]'
    planning-frontmatter "$(junie_agent_frontmatter PLANNING sonnet medium)"
    implementation-frontmatter "$(junie_agent_frontmatter IMPLEMENTATION haiku high)"
    verification-frontmatter "$(junie_agent_frontmatter VERIFICATION haiku high)"

    # Tool agents use to run shell commands.
    shell-tool '`Bash`'
)

main "$@"
