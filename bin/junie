#!/usr/bin/env bash
#
# Installs, uninstalls, and checks the task dispatcher templates in ~/.junie
# (or $JUNIE_HOME).
#
#   bin/junie install            Render and copy commands + agents
#   bin/junie uninstall          Remove only the files this repo installed
#   bin/junie doctor [--diff]    Check installed files against the rendered templates
#
# Templates use {{placeholder}} tags so commands/ and agents/ stay tool-neutral.
# Override per-agent models and reasoning with JUNIE_*_MODEL / JUNIE_*_REASONING
# (or JUNIE_DEFAULT_MODEL / JUNIE_DEFAULT_REASONING) in .env or your shell.
# Setting one to empty drops that field from front matter completely.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    link_dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$link_dir/$SCRIPT_PATH"
done
source "$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)/lib/installer.sh"

TOOL_NAME="Junie"
HOME_ENV_VAR="JUNIE_HOME"
DEFAULT_HOME="$HOME/.junie"

# Builds an agent's front matter from $1 (like PLANNING), falling back through
# JUNIE_DEFAULT_* to the script's built-in defaults ($2, $3).
junie_agent_frontmatter() {
    local model_var="JUNIE_$1_MODEL" reasoning_var="JUNIE_$1_REASONING" default_model default_reasoning model reasoning
    default_model="${JUNIE_DEFAULT_MODEL-$2}"
    default_reasoning="${JUNIE_DEFAULT_REASONING-$3}"
    model="${!model_var-$default_model}"
    reasoning="${!reasoning_var-$default_reasoning}"
    join_lines \
        "${model:+model: \"$model\"}" \
        "${reasoning:+reasoningLevel: \"$reasoning\"}" \
        'allowPromptArgument: true'
}

read_tasks_dir _task_dispatcher_tasks_dir '.junie/tasks'

# Alternating placeholder name/value pairs (empty values are fine).
PLACEHOLDERS=(
    # Command front matter and the variable holding the command's argument.
    command-frontmatter 'allowPromptArgument: true'
    task-argument       '$task'

    # Project-relative folder for the task pipeline directories.
    tasks-dir           "$_task_dispatcher_tasks_dir"

    # Tool the dispatcher uses to spawn a sub-agent.
    spawn-agent         '`spawn_subagent`'

    # Agent front matter: tool allow-list, and model settings per agent.
    agent-tools 'tools: ["Read", "Glob", "Grep", "Write", "Edit", "Bash"]'
    planning-frontmatter "$(junie_agent_frontmatter PLANNING sonnet high)"
    implementation-frontmatter "$(junie_agent_frontmatter IMPLEMENTATION sonnet low)"
    verification-frontmatter "$(junie_agent_frontmatter VERIFICATION sonnet low)"

    # Tool agents use to run shell commands.
    shell-tool '`Bash`'

    # Tools the dispatcher uses to create and edit task files.
    file-edit-tools 'your file create/edit tools (e.g. `create`, `search_replace`, `multi_edit`)'
)

main "$@"
